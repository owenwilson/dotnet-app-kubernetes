## Frontend Assets & Node (Common in MVC for bundlers/minifiers)
## #######################################################################
node_modules/
bower_components/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache

## #######################################################################
## IDE and Editor Specific Files
## #######################################################################
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
UpgradeLog.XML
_UpgradeReport_Files/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

## #######################################################################
## Environment Secrets and Local Configurations
## #######################################################################
# NEVER commit production secrets or local connection strings
*.env
*.env.local
.env.*.local

# User Secrets (Stored outside project directory by default, but safe to exclude)
secrets.json

# Local App Settings overrides
appsettings.Development.json
appsettings.Local.json

